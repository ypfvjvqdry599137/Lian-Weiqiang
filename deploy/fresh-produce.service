[Unit]
Description=Fresh Produce Mini Program Backend
After=network-online.target mysql.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Lian-Weiqiang/backend
Environment="PATH=/home/ubuntu/Lian-Weiqiang/backend/venv/bin"
ExecStart=/home/ubuntu/Lian-Weiqiang/backend/venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 1 --threads 4 --timeout 60 app:create_app()
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
