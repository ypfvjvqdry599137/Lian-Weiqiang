.container {
  padding: 20rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 收货地址卡片 */
.address-card {
  background: linear-gradient(135deg, #E8F5E9 0%, #F1F8E9 100%);
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.08);
  position: relative;
  overflow: hidden;
}

.address-card::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6rpx;
  background: repeating-linear-gradient(
    -45deg,
    #4CAF50 0,
    #4CAF50 12rpx,
    transparent 12rpx,
    transparent 24rpx
  );
  opacity: 0.4;
}

.address-left {
  flex-shrink: 0;
}

.address-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(76, 175, 80, 0.3);
}

.address-icon {
  width: 36rpx;
  height: 36rpx;
}

.address-info {
  flex: 1;
  min-width: 0;
}

.addr-name-phone {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.addr-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.addr-phone {
  font-size: 26rpx;
  color: #555;
}

.addr-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.placeholder-text {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.placeholder-sub {
  display: block;
  font-size: 24rpx;
  color: #888;
}

.arrow-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

/* 配送信息卡片 */
.delivery-card {
  background: white;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.delivery-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.delivery-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx;
  background: #F5F7FA;
  border-radius: 14rpx;
}

.delivery-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.delivery-text {
  flex: 1;
  min-width: 0;
}

.delivery-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.delivery-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.delivery-value.loading {
  color: #bbb;
}

.delivery-fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  border-radius: 14rpx;
}

.fee-label {
  font-size: 26rpx;
  color: #6b6b6b;
}

.fee-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #ff5722;
}

.range-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #FFEBEE;
  border-radius: 12rpx;
}

.tip-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #e53935;
}

/* 通用 section */
.section {
  background: white;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.section-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

/* 商品列表 */
.product-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.product-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.product-item:first-of-type {
  padding-top: 0;
}

.product-img-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #f5f7fa;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-detail {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 140rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 6rpx;
  line-height: 1.4;
}

.tag-processing {
  background: #E3F2FD;
  color: #1e88e5;
}

.tag-preorder {
  background: #FFF3E0;
  color: #e67e22;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 10rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: #ff5722;
  font-weight: bold;
}

.price {
  color: #ff5722;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1;
}

.quantity {
  font-size: 26rpx;
  color: #888;
  background: #f5f7fa;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* 备注 */
.textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 14rpx;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 底部结算栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.footer-total {
  flex: 1;
  min-width: 0;
}

.total-main {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.total-label {
  font-size: 26rpx;
  color: #333;
}

.total-symbol {
  font-size: 24rpx;
  color: #ff5722;
  font-weight: bold;
}

.total-amount {
  font-size: 44rpx;
  font-weight: bold;
  color: #ff5722;
  line-height: 1;
}

.total-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
}

.submit-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: white;
  border: none;
  border-radius: 999rpx;
  padding: 22rpx 56rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(76, 175, 80, 0.3);
}

.submit-btn[disabled] {
  background: #d0d0d0;
  color: #fff;
  box-shadow: none;
}

.btn-primary-hover {
  opacity: 0.88;
  transform: scale(0.98);
}
