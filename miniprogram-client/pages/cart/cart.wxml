<view class="container">
  <!-- 空购物车 -->
  <view class="empty-state" wx:if="{{cartItems.length === 0}}">
    <image class="empty-state-icon" src="/images/icons/empty-cart.svg" mode="aspectFit" />
    <text class="empty-state-text">购物车还是空的</text>
    <button class="empty-state-btn" hover-class="btn-primary-hover" bindtap="goShopping">去逛逛</button>
  </view>

  <!-- 购物车列表 -->
  <view class="cart-list" wx:else>
    <view class="cart-item" wx:for="{{cartItems}}" wx:key="id">
      <view class="item-left">
        <image src="{{item.product_image || ''}}" class="item-img" />
      </view>
      <view class="item-right">
        <view class="item-name">{{item.product_name}}</view>
        <view class="item-extra" wx:if="{{item.processing_option || item.is_preorder}}">
          <text wx:if="{{item.processing_option}}" style="display:block;color:#1e88e5;font-size:22rpx;margin-top:6rpx;">加工：{{item.processing_option}}</text>
          <text wx:if="{{item.is_preorder}}" style="display:block;color:#e67e22;font-size:22rpx;margin-top:4rpx;">预定商品</text>
        </view>        <view class="item-bottom">
          <view class="price-section">
            <text class="price">¥{{item.price}}</text>
          </view>
          <view class="quantity-control">
            <view class="btn-minus" hover-class="qty-btn-hover" bindtap="updateQuantity" data-id="{{item.id}}" data-quantity="{{item.quantity - 1}}">
              <image class="qty-icon" src="/images/icons/minus.svg" mode="aspectFit" />
            </view>
            <text class="quantity">{{item.quantity}}</text>
            <view class="btn-plus" hover-class="qty-btn-hover" bindtap="updateQuantity" data-id="{{item.id}}" data-quantity="{{item.quantity + 1}}">
              <image class="qty-icon" src="/images/icons/plus.svg" mode="aspectFit" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部结算栏 -->
  <view class="checkout-bar" wx:if="{{cartItems.length > 0}}">
    <view class="total-section">
      <text class="total-label">合计</text>
      <text class="total-price">¥{{totalPrice}}</text>
    </view>
    <button class="checkout-btn" hover-class="btn-primary-hover" bindtap="goCheckout">去结算 ({{totalQuantity}})</button>
  </view>

  <!-- 底部导航栏 -->
  <view class="bottom-nav">
    <view class="bottom-nav-item" hover-class="bottom-nav-hover" bindtap="goToIndex">
      <image class="nav-icon-img" src="/images/icons/home.svg" />
      <text class="nav-text">首页</text>
    </view>
    <view class="bottom-nav-item" hover-class="bottom-nav-hover" bindtap="goToCategory">
      <image class="nav-icon-img" src="/images/icons/category.svg" />
      <text class="nav-text">分类</text>
    </view>
    <view class="bottom-nav-item active">
      <image class="nav-icon-img" src="/images/icons/cart-active.svg" />
      <text class="nav-text">购物车</text>
    </view>
    <view class="bottom-nav-item" hover-class="bottom-nav-hover" bindtap="goToOrders">
      <image class="nav-icon-img" src="/images/icons/user.svg" />
      <text class="nav-text">我的</text>
    </view>
  </view>
</view>
