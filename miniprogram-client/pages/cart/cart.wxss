.container {
  padding-bottom: 240rpx;
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.item-left {
  margin-right: 20rpx;
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.item-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-minus, .btn-plus {
  width: 50rpx;
  height: 50rpx;
  border: 1rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.btn-plus {
  background: #4CAF50;
  border-color: #4CAF50;
}

.qty-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 空状态图标 */
.empty-state .empty-state-icon {
  width: 140rpx;
  height: 140rpx;
  font-size: 0;
  margin-bottom: 24rpx;
  opacity: 1;
}

.qty-btn-hover {
  background: #f5f7fa;
  transform: scale(0.92);
}

.quantity {
  font-size: 30rpx;
  min-width: 40rpx;
  text-align: center;
  color: #333;
  font-weight: 500;
}

/* 底部结算栏 */
.checkout-bar {
  position: fixed;
  bottom: 130rpx;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.total-section {
  flex: 1;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff5722;
  margin-left: 10rpx;
}

.checkout-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: white;
  border: none;
  border-radius: 999rpx;
  padding: 18rpx 44rpx;
  font-size: 30rpx;
  line-height: 1.4;
}

.checkout-btn::after {
  border: none;
}
