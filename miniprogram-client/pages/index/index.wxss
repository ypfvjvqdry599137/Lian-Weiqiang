.container {
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
  background-color: #f5f7fa;
  min-height: 100vh;
}

.header {
  padding: 20rpx;
  background: linear-gradient(180deg, #4CAF50 0%, #45a049 100%);
  color: white;
}

.address {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255,255,255,0.2);
  padding: 16rpx 20rpx;
  border-radius: 40rpx;
  margin-bottom: 16rpx;
}

.address-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.address-text {
  flex: 1;
}

.address-name {
  font-size: 26rpx;
  font-weight: bold;
  display: block;
  line-height: 1.2;
}

.address-detail {
  font-size: 20rpx;
  opacity: 0.9;
  display: block;
  line-height: 1.2;
}

.arrow {
  font-size: 20rpx;
  opacity: 0.8;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  opacity: 0.9;
}

.search {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  gap: 12rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 26rpx;
  color: #333;
  background: transparent;
  padding: 0;
  border: 0;
}

.search-placeholder {
  font-size: 26rpx;
  color: #999;
}

.banner {
  width: 100%;
  height: 320rpx;
  margin-bottom: 20rpx;
}

.banner-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-1 {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
}

.banner-2 {
  background: linear-gradient(135deg, #4CAF50 0%, #8BC34A 100%);
}

.banner-3 {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.banner-text {
  color: white;
  font-size: 40rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

/* 快捷分类 */
.quick-nav {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 20rpx 32rpx;
  background: white;
  margin-bottom: 20rpx;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.nav-item-hover {
  opacity: 0.6;
}

.quick-nav-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid #ebebeb;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.quick-nav-icon-img {
  width: 100%;
  height: 100%;
  display: block;
}

.nav-name {
  font-size: 26rpx;
  color: #555;
  line-height: 1.2;
  text-align: center;
}

/* 通用区域样式 */
.section {
  padding: 20rpx;
  background: white;
  margin-bottom: 20rpx;
}

.section:last-of-type {
  margin-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.title-icon {
  width: 34rpx;
  height: 34rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.more {
  font-size: 24rpx;
  color: #999;
}

/* 限时特惠 */
.flash-list {
  display: flex;
  white-space: nowrap;
}

.flash-item {
  display: inline-block;
  width: 220rpx;
  margin-right: 16rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  overflow: hidden;
}

.flash-img {
  width: 100%;
  height: 180rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f5e9 100%);
}

.flash-img .img {
  width: 100%;
  height: 100%;
}

.flash-info {
  padding: 16rpx;
}

.flash-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flash-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.flash-price .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff5722;
}

.flash-price .unit {
  font-size: 22rpx;
  color: #666;
}

/* 商品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.product-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  min-height: 470rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.card-hover {
  transform: scale(0.97);
  opacity: 0.92;
}

.product-image {
  width: 100%;
  height: 280rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f5e9 100%);
}

.product-img {
  width: 100%;
  height: 100%;
}

.img-placeholder,
.product-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon-img {
  width: 80rpx;
  height: 80rpx;
}

.product-info {
  padding: 16rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.product-desc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8rpx;
  margin-top: auto;
}

.price-box {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.price-box .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff5722;
}

.price-box .unit {
  font-size: 22rpx;
  color: #666;
}

.add-btn {
  width: 50rpx;
  height: 50rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(76, 175, 80, 0.3);
}

.add-btn-icon {
  width: 28rpx;
  height: 28rpx;
}

.add-btn-hover {
  transform: scale(0.85);
  box-shadow: 0 2rpx 6rpx rgba(76, 175, 80, 0.3);
}

.add-icon {
  font-size: 32rpx;
  color: white;
  line-height: 1;
}

/* 空状态图标 */
.empty-state .empty-state-icon {
  width: 140rpx;
  height: 140rpx;
  font-size: 0;
  margin-bottom: 24rpx;
  opacity: 1;
}

/* 自提点选择器 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
}

.picker-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 30rpx 30rpx 0 0;
  z-index: 1000;
  max-height: 70vh;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.15);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-cancel,
.picker-confirm {
  font-size: 30rpx;
  color: #666;
  padding: 10rpx;
}

.picker-confirm {
  color: #4CAF50;
  font-weight: bold;
}

.picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.picker-list {
  padding: 20rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.picker-item {
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background: #f5f7fa;
  transition: all 0.3s;
}

.picker-item.active {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  border: 2rpx solid #4CAF50;
}

.station-item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.station-item-address {
  font-size: 26rpx;
  color: #666;
}

/* 购物车悬浮条 */
.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  background: #333;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  padding-right: 12rpx;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.25);
  z-index: 998;
  animation: cartBarUp 0.3s ease;
  overflow: hidden;
}

@keyframes cartBarUp {
  from { transform: translateY(140rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.cart-bar-hover {
  opacity: 0.9;
}

.cart-bar-cart {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  border-radius: 50%;
  margin-left: 10rpx;
  flex-shrink: 0;
  transition: transform 0.15s;
}

.cart-bar-cart-hover {
  transform: scale(0.88);
}

.cart-bar-icon {
  width: 44rpx;
  height: 44rpx;
}

.cart-bar-badge {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  background: #ff5722;
  color: #fff;
  font-size: 18rpx;
  font-weight: bold;
  border-radius: 999rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid #333;
}

.cart-bar-info {
  flex: 1;
  padding-left: 20rpx;
}

.cart-bar-amount {
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
}

.cart-bar-action {
  background: linear-gradient(135deg, #ff5722 0%, #f43f00 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  font-weight: 500;
  flex-shrink: 0;
}
