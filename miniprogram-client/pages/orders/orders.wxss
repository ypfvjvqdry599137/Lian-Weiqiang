.container {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.tabs {
  display: flex;
  background: white;
  margin-bottom: 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #4CAF50;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #4CAF50;
  border-radius: 2rpx;
}

.order-card {
  background: white;
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-sn {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: bold;
}

.status-10,
.status-20 {
  color: #ff9800;
}

.status-30,
.status-40 {
  color: #2563eb;
}

.status-50 {
  color: #4CAF50;
}

.status-60 {
  color: #999;
}

.order-content {
  margin-bottom: 20rpx;
}

.product-mini {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 28rpx;
}

.product-name {
  color: #333;
}

.product-qty {
  color: #666;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-price {
  font-size: 28rpx;
  color: #ff5722;
  font-weight: bold;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
}

.cancel-btn {
  width: 170rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #e64340;
  border-radius: 30rpx;
  background: #fff;
  color: #e64340;
  font-size: 26rpx;
}

.cancel-btn::after {
  border: none;
}

.cancel-btn:active {
  background: #fff5f5;
}

/* 空状态图标 */
.empty-state .empty-state-icon {
  width: 140rpx;
  height: 140rpx;
  font-size: 0;
  margin-bottom: 24rpx;
  opacity: 1;
}
