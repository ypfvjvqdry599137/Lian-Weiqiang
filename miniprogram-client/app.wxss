/* ========== 设计系统变量 ========== */
page {
  /* 主题色 */
  --color-primary: #4CAF50;
  --color-primary-dark: #45a049;
  --color-primary-light: #E8F5E9;
  --color-primary-bg: #edf8ef;
  /* 功能色 */
  --color-price: #ff5722;
  --color-danger: #e64340;
  --color-warning: #ff9800;
  --color-info: #2563eb;
  /* 文字 */
  --color-text: #333;
  --color-text-secondary: #666;
  --color-text-placeholder: #999;
  /* 背景 */
  --color-bg: #f5f7fa;
  --color-card: #ffffff;
  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 999rpx;
  /* 阴影 */
  --shadow-card: 0 2rpx 12rpx rgba(0,0,0,0.06);
  --shadow-nav: 0 -4rpx 20rpx rgba(0,0,0,0.08);

  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #333;
  font-size: 28rpx;
}

.container {
  padding: 20rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 价格 */
.price {
  color: #ff5722;
  font-size: 36rpx;
  font-weight: bold;
}

.price-original {
  color: #999;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 10rpx;
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: #fff;
  border: none;
  border-radius: 999rpx;
}

.btn-primary-hover {
  opacity: 0.85;
}

/* ========== 通用空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.empty-state-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 18rpx 56rpx;
  border-radius: 999rpx;
  border: none;
  line-height: 1.4;
}

.empty-state-btn::after {
  border: none;
}

/* ========== 通用 loading ========== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #e8f5e9;
  border-top-color: #4CAF50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* ========== 底部导航栏（全局统一） ========== */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  min-height: 98rpx;
  padding: 15rpx 0;
  padding-bottom: calc(15rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 1000;
}

.bottom-nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: #999;
  transition: color 0.2s;
}

.bottom-nav-item.active {
  color: #4CAF50;
}

.bottom-nav-item .nav-icon {
  font-size: 40rpx;
  line-height: 1;
}

.bottom-nav-item .nav-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.bottom-nav-item .nav-text {
  font-size: 22rpx;
  line-height: 1;
}

.bottom-nav-hover {
  background: rgba(76,175,80,0.06);
}
